put:<\/b><span style=\"font-weight: 400\"> 6000W<\/span><\/li>\r\n \t<li style=\"font-weight: 400\"><b>MPPTs:<\/b><span style=\"font-weight: 400\"> 1<\/span><\/li>\r\n \t<li style=\"font-weight: 400\"><b>Backup\/EPS:<\/b><span style=\"font-weight: 400\"> 4000W output with 10ms UPS switching \/ 20ms appliance switching<\/span><\/li>\r\n \t<li style=\"font-weight: 400\"><b>Protection Rating:<\/b><span style=\"font-weight: 400\"> IP54<\/span><\/li>\r\n \t<li><strong>Warranty:<\/strong> 3-Year Replacement Warranty + 5-Year Service Warranty<\/li>\r\n<\/ul>","featuredImage":"https:\/\/hajverysolar.com\/wp-content\/uploads\/2026\/02\/Itel-4KW-6KW-Pro-IP54-Hybrid-Inverter-800x800.png"}};
