<script type="application/ld+json">{"@context":"https://schema.org/","@type":"Product","@id":"https://hajverysolar.com/product/itel-4kw-pro-ip54-hybrid-inverter/#product","name":"Itel 4KW Pro IP54 Hybrid Inverter","url":"https://hajverysolar.com/product/itel-4kw-pro-ip54-hybrid-inverter/","description":"The itel 4KW Pro Hybrid Inverter is a single-phase 24V low-voltage hybrid inverter designed for solar PV, battery storage, grid supply and backup loads. With up to 6000W PV input, a 120A maximum MPPT charging current, lithium-ion and lead-acid battery support, and dual-output capability for smart and main loads, it is suitable for homes and small backup systems. The inverter also provides IP54 protection, diesel generator support and smart load support, making it a practical option for users looking for a 4kW hybrid inverter for solar self-consumption and load-shedding backup.\r\nQuick Highlights\r\n\r\n \tRated Output: 4000W\r\n \tPhase: Single Phase\r\n \tBattery Type/Voltage: Lead-acid / Lithium-ion / User Defined, 24V\r\n \tMax PV Input: 6000W\r\n \tMPPTs: 1\r\n \tBackup/EPS: 4000W output with 10ms UPS switching / 20ms appliance switching\r\n \tProtection Rating: IP54\r\n \tWarranty: 3-Year Replacement Warranty + 5-Year Service Warranty","image":"https://hajverysolar.com/wp-content/uploads/2026/02/Itel-4KW-6KW-Pro-IP54-Hybrid-Inverter.png","sku":31596,"offers":[{"@type":"Offer","priceSpecification":[{"@type":"UnitPriceSpecification","price":"110000.00","priceCurrency":"PKR","validThrough":"2027-12-31"}],"priceValidUntil":"2027-12-31","availability":"https://schema.org/InStock","url":"https://hajverysolar.com/product/itel-4kw-pro-ip54-hybrid-inverter/","seller":{"@type":"Organization","name":"Hajvery Solar Energy","url":"https://hajverysolar.com"},"price":"110000.00","priceCurrency":"PKR"}]}</script>			<script>
				( () => {
					const lazyloadRunObserver = () => {
						const lazyloadBackgrounds = document.querySelectorAll( `.e-con.e-parent:not(.e-lazyloaded)` );
						const lazyloadBackgroundObserver = new IntersectionObserver( ( entries ) => {
							entries.forEach( ( entry ) => {
								if ( entry.isIntersecting ) {
									let lazyloadBackground = entry.target;
									if( lazyloadBackground ) {
										lazyloadBackground.classList.add( 'e-lazyloaded' );
									}
									lazyloadBackgroundObserver.unobserve( entry.target );
								}
							});
						}, { rootMargin: '200px 0px 200px 0px' } );
						lazyloadBackgrounds.forEach( ( lazyloadBackground ) => {
							lazyloadBackgroundObserver.observe( lazyloadBackground );
						} );
					};
					const events = [
						'DOMContentLoaded',
						'elementor/lazyload/observe',
					];
					events.forEach( ( event ) => {
						document.addEventListener( event, lazyloadRunObserver );
					} );
				} )();
			</script>
