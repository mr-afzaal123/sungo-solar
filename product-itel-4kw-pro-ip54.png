/* ==========================================
   HAJVERY SOLAR CATEGORY CARDS
   TABLET + MOBILE DESKTOP-STYLE OVERLAY
========================================== */

@media (max-width: 1024px) {

    /* Main image-box wrapper */
    .elementor-element-b71bdce .elementor-image-box-wrapper {
        position: relative !important;
        overflow: hidden;
        border-radius: 6px;
    }

    /* Image container */
    .elementor-element-b71bdce .elementor-image-box-img {
        width: 100% !important;
        margin: 0 !important;
    }

    /* Image link */
    .elementor-element-b71bdce .elementor-image-box-img a {
        display: block;
        width: 100%;
    }

    /* Image itself */
    .elementor-element-b71bdce .elementor-image-box-img img {
        display: block;
        width: 100%;
        height: auto;
    }

    /* Title overlay container */
    .elementor-element-b71bdce .elementor-image-box-content {
        position: absolute !important;
        left: 0;
        right: 0;
        bottom: 0;
        width: 100%;
        z-index: 3;
    }

    /* Title bar */
    .elementor-element-b71bdce .elementor-image-box-title {
        margin: 0 !important;
        padding: 7px 5px;

        background: rgba(0, 0, 0, 0.45) !important;
        color: #ffffff !important;

        font-size: 13px !important;
        font-weight: 600 !important;
        line-height: 1.2;

        text-align: center !important;
        letter-spacing: 0.2px;

        white-space: nowrap;
    }

    /* Title link */
    .elementor-element-b71bdce .elementor-image-box-title a {
        display: block;
        width: 100%;

        color: #ffffff !important;
        text-decoration: none !important;
        text-align: center !important;

        font-size: inherit !important;
        font-weight: inherit !important;
        line-height: inherit;
    }
}


/* ==========================================
   SMALL MOBILE
========================================== */

@media (max-width: 430px) {

    .elementor-element-b71bdce .elementor-image-box-title {
        font-size: 12px !important;
        padding: 6px 4px;
        letter-spacing: 0;
    }
}
